# ── Supabase ────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # NEVER expose this on the frontend

# ── Server ──────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5500   # URL of your frontend (for CORS)

# ── Session ─────────────────────────────────────────────────
# Generate a random 64-char string:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_secret_here
